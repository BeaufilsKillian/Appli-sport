# Secrets serveur Vercel uniquement. Ne jamais utiliser de préfixe EXPO_PUBLIC_.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
NEON_AUTH_BASE_URL=https://AUTH-URL-FOURNIE-PAR-NEON
NEON_AUTH_COOKIE_SECRET=GENERER_UN_SECRET_ALEATOIRE_D_AU_MOINS_32_CARACTERES
APP_ORIGIN=https://NOM-DU-PROJET.vercel.app
# Générés par scripts/setup-access.mjs, conservés exclusivement sur le serveur.
ADMIN_EMAIL=
ADMIN_USER_ID=
ADMIN_PASSWORD_HASH=
ACCESS_LEASE_PRIVATE_JWK=
ADMIN_VAPID_PUBLIC_KEY=
ADMIN_VAPID_PRIVATE_KEY=
